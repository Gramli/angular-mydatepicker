{
  "name": "angular-mydatepicker-example",
  "version": "22.0.0",
  "description": "A highly configurable Angular datepicker and date range picker with no external dependencies. Lightweight, flexible, and feature-rich.",
  "keywords": [
    "angular",
    "angular-date-picker",
    "date-picker",
    "datepicker",
    "date-range-picker",
    "calendar",
    "angular-calendar",
    "angular-ui",
    "angular-components",
    "lightweight",
    "typescript",
    "date-input",
    "form-control",
    "form-field",
    "customizable",
    "ui-component",
    "date-selection"
  ],
  "author": "gramli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gramli/angular-mydatepicker.git"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "node scripts/delete-dist-folder.js && ng build AngularMyDatePicker --configuration production && node scripts/copy-artifacts.js",
    "build-example": "ng build --base-href=\"https://gramli.github.io/angular-mydatepicker/\"",
    "test-lib": "node scripts/delete-test-output-folder.js && ng test --code-coverage=true --browsers=ChromeHeadless --no-watch AngularMyDatePicker",
    "lint-lib": "ng lint AngularMyDatePicker"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-service": "^22.2.1",
    "@types/jasmine": "~5.1.13",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.1",
    "fs-extra": "^8.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^22.2.4",
    "typescript": "^6.0.3"
  }
}
